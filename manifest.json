{
  "manifest_version": 2,
  "name": "Open Shortcut",
  "version": "1.1.0",
  "description": "Compact shortcuts with Firefox theme matching, custom backgrounds and text backups.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "popup.html#edit",
    "open_in_tab": true
  },
  "browser_action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Click to open Shortcut"
  }
}
